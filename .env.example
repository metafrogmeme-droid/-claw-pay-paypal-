# Copy to .env on YOUR machine only (never commit .env). Values stay empty in this file.
# The agent process must never read this file; only the gate does.

# --- Claw Pay keys (fill with: pnpm --filter @claw-pay/cli exec cp-keys --chain-id 84532) ---
CP_CHAIN_ID=
CP_BUDGET_PRIVATE_KEY=
CP_OWNER_PRIVATE_KEY=
CP_GUARDIAN_PRIVATE_KEY=

# Mainnet guard: only "yes" on the owner's operator computer after the owner's go. Never in CI.
MAINNET_GO=

# --- Feature flags (all default off) ---
ENABLE_PAID_CHECK=
ENABLE_MAINNET=
ENABLE_MPP=
ENABLE_AP2=
ENABLE_LLM_AGENT=

# --- PayPal (sandbox only; see README.md and docs/DECISIONS.md D-023, D-024) ---
# The gate refuses to start unless PAYPAL_ENVIRONMENT is exactly SANDBOX.
PAYPAL_ENVIRONMENT=
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# Merchant id of YOUR sandbox business account (the REST app owner). The gate re-checks it before capture.
PAYPAL_SANDBOX_PAYEE_MERCHANT_ID=

# --- LLM shopping agent (cp-agent; needs ENABLE_LLM_AGENT=yes; see D-025) ---
# Flovia is the default. Anthropic only when LLM_PROVIDER=anthropic. No automatic fallback.
LLM_PROVIDER=
FLOVIA_API_KEY=
# Flovia OpenAI Responses API (POST {base}/responses with a Flovia-Operation-Id per call), https only.
# Empty = https://api.flovia.dev/openai/v1 and model gpt-6-luna.
FLOVIA_BASE_URL=
FLOVIA_MODEL=
ANTHROPIC_API_KEY=
# Empty = the cheap default model (claude-haiku-5-5).
ANTHROPIC_MODEL=
# Spend guard. Empty = defaults: 512 output tokens per call (hard cap 1024), 0.05 USD per run, 3 calls per run.
LLM_MAX_TOKENS=
LLM_MAX_RUN_USD=
LLM_MAX_CALLS=
# Hard stop: "yes" here, or create the file .claw-pay/LLM_STOP, and no further LLM call is sent.
LLM_HARD_STOP=
LLM_STOP_FILE=
# JSONL spend log (counts and costs only). Empty = .claw-pay/llm-spend.jsonl (git-ignored).
LLM_SPEND_LOG=
