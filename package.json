{
  "name": "claw-pay",
  "private": true,
  "license": "MIT",
  "description": "Claw Pay: a rule gate for AI-agent payments (x402, PayPal sandbox).",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "pnpm -r run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "copy-lint": "node scripts/copy-lint.mjs",
    "gitleaks:selftest": "bash scripts/gitleaks-selftest.sh",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run coverage && pnpm run copy-lint"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
