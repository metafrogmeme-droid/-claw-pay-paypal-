{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "@claw-pay/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/test/**/*",
    "scripts/**/*.mjs",
    "*.config.ts",
    "eslint.config.js"
  ]
}
